---
import Segmented from '@components/molecules/Segmented.astro';

const themes = [
  { value: 'dark', label: 'Ciemny', icon: 'moon' },
  { value: 'light', label: 'Jasny', icon: 'sun' },
  { value: 'system', label: 'Systemowy', icon: 'desktop' },
];

const defaultTheme = 'dark';
const name = `theme-${crypto.randomUUID()}`;
---

<Segmented class="theme-switcher" label="Motyw" name={name} options={themes} value={defaultTheme} />
<script is:inline>
  window.webCheckTheme?.apply();
</script>
