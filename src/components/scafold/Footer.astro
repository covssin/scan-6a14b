---
import Logo from '@components/molecules/Logo.astro';

interface Props {
  miniView?: boolean;
}

const { miniView = false } = Astro.props;

const projectName = 'Web Check';
const siteUrl = 'https://kmucha.pl';
const siteLabel = 'kmucha.pl';
const currentYear = new Date().getFullYear();

// Kolejne pozycje lub całe kolumny linków możesz dopisywać tutaj
const linkGroups = [
  {
    title: 'Linki',
    links: [
      { label: siteLabel, href: siteUrl },
    ],
  },
];
---

<footer>
  {!miniView && (
    <div class="links">
      <div class="intro">
        <a href="/">
          <Logo />
          {projectName}
        </a>
        <p>
          Kompleksowe narzędzie pozwalające przeanalizować budowę oraz konfigurację dowolnej strony internetowej.
        </p>
      </div>
      <nav aria-label="Stopka">
        {linkGroups.map((group) => (
          <div>
            <h2>{group.title}</h2>
            <ul>
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={link.href.startsWith('http') ? '_blank' : undefined}
                    rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>
  )}
  <div class="bar">
    <p>
      © {currentYear}{' '}
      <a href={siteUrl} target="_blank" rel="noopener noreferrer">
        {siteLabel}
      </a>
    </p>
  </div>
</footer>

<style lang="scss">
  @use '@styles/global.scss' as *;
  $gap: 2rem clamp(2rem, 5vw, 4rem);
  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: $gap;
    padding: 3rem calc((100% - var(--page-width)) / 2);
    background: var(--background-raised);
    border-top: 1px solid var(--border);
    @include mobile-down {
      display: grid;
    }
    .intro {
      flex: 1 1 13rem;
      max-width: 20rem;
      a {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--text-color);
        :global(.logo) {
          width: 1.6em;
        }
      }
      p {
        margin: 0.5rem 0 0;
        line-height: 1.5;
        color: var(--text-color-secondary);
      }
    }
    nav {
      display: grid;
      grid-template-columns: repeat(3, auto);
      gap: $gap;
      @include tablet-landscape-down {
        grid-template-columns: repeat(2, auto);
        > div:has(li:nth-child(6)) {
          grid-row: span 2;
        }
      }
      @include mobile-down {
        grid-template-columns: 1fr;
      }
    }
    h2 {
      margin-bottom: 1rem;
      font-size: 0.85rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: color-mix(in srgb, var(--primary-increased-contrast) 75%, var(--text-color));
    }
    ul {
      display: grid;
      gap: 0.6rem;
      margin: 0;
      padding: 0;
      list-style: none;
      line-height: 1.4;
      @include large-desktop-up {
        &:has(> li:nth-child(6)) {
          grid-template-rows: repeat(4, auto);
          grid-auto-flow: column;
          column-gap: 2.5rem;
        }
      }
    }
    li a {
      color: var(--text-color-secondary);
      transition: color 0.25s ease;
      &:hover,
      &:focus-visible {
        color: color-mix(in srgb, var(--primary-increased-contrast) 75%, var(--text-color));
      }
    }
  }
  .bar {
    display: flex;
    justify-content: center;
    gap: 0.25rem 1rem;
    flex-wrap: wrap;
    padding: 0.4rem 1rem;
    font-size: 0.85rem;
    line-height: 1.5;
    background: var(--primary-increased-contrast);
    color: #ffffff;
    p {
      margin: 0;
    }
    a {
      color: inherit;
      text-decoration: underline;
    }
    @include tablet-portrait-down {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
  }
</style>
