---
import PageLayout from '@layouts/Page.astro';
import OptionCards from '@components/molecules/OptionCards.astro';
import SponsorCard from '@components/molecules/SponsorCard.astro';

const cardData = [
  {
    title: 'Uruchomienie przez Docker',
    description:
      'Jedno polecenie wystarczy, aby uruchomić własną instancję SCAN_KMucha na swoim serwerze w kilka minut.',
    command: 'docker run -p 3000:3000 lissy93/web-check',
  },
  {
    title: 'Wdrożenie jednym kliknięciem',
    description:
      'Nie masz własnego serwera? Żaden problem! Wdróż aplikację jednym kliknięciem na Vercel, Netlify, Render lub Hostinger.',
    buttons: [
      {
        name: 'Vercel',
        image: '/assets/images/vercel.svg',
        link:
          'https://vercel.com/new/clone?repository-url=https%3A%2F%2Fgithub.' +
          'com%2Flissy93%2Fweb-check&project-name=web-check&repository' +
          '-name=web-check&demo-title=Web%20Check&demo-description=Try%20ou' +
          't%20the%20live%20demo&demo-url=https%3A%2F%2Fweb-check.xyz%2F&demo-ima' +
          'ge=https%3A%2F%2Fi.ibb.co%2Fr0jXN6s%2Fweb-check.png',
      },
      {
        name: 'Netlify',
        image: '/assets/images/netlify.svg',
        link:
          'https://app.netlify.com/start/deploy?repository=' +
          'https://github.com/lissy93/web-check',
      },
      {
        name: 'Render',
        image: '/assets/images/render.svg',
        link: 'https://render.com/deploy?repo=https://github.com/Lissy93/web-check',
      },
      {
        name: 'Hostinger',
        image: '/assets/images/hostinger.svg',
        link: 'https://www.hostg.xyz/aff_c?offer_id=48&aff_id=243972&url_id=6826',
      },
    ],
  },
  {
    title: 'Budowanie ze źródeł',
    description: 'Chcesz dostosować SCAN_KMucha do własnych potrzeb? Sklonuj repozytorium i uruchom projekt na swoim serwerze.',
    buttons: [
      {
        name: 'kmucha.pl',
        image: '/assets/images/swagger.svg',
        link: 'https://kmucha.pl',
        newTab: true,
      },
    ],
  },
];

type ConfigOption = { key: string; info: string; example?: string; link?: string };

const configGroups: { title: string; description: string; options: ConfigOption[] }[] = [
  {
    title: 'Klucze API',
    description: 'Odblokuj dodatkowe testy lub zwiększ limity zapytań dla zewnętrznych interfejsów API.',
    options: [
      {
        key: 'GOOGLE_CLOUD_API_KEY',
        info: 'Uruchamia testy jakości (PageSpeed Insights) oraz Google Safe Browsing',
        link: 'https://developers.google.com/speed/docs/insights/v5/get-started',
      },
      {
        key: 'SHODAN_API_KEY',
        info: 'Uruchamia testy nazw hostów, informacji o serwerze oraz znanych podatności',
        link: 'https://account.shodan.io/',
      },
      {
        key: 'CLOUDMERSIVE_API_KEY',
        info: 'Dodaje skanowanie reputacji witryny Cloudmersive do modułu zagrożeń',
        link: 'https://account.cloudmersive.com/',
      },
      {
        key: 'TRANCO_API_KEY',
        info: 'Zwiększa limit zapytań Tranco dla testu rankingu popularności domeny',
        link: 'https://tranco-list.eu/',
      },
      { key: 'TRANCO_USERNAME', info: 'Adres e-mail konta Tranco używany wraz z powyższym kluczem' },
      {
        key: 'GITHUB_TOKEN',
        info: 'Zwiększa limit zapytań GitHub API w teście obecności w mediach społecznościowych',
        link: 'https://github.com/settings/tokens',
      },
      {
        key: 'CERTSPOTTER_TOKEN',
        info: 'Zwiększa limit zapytań CertSpotter w teście wyszukiwania subdomen',
        link: 'https://sslmate.com/certspotter/api/',
      },
    ],
  },
  {
    title: 'Ustawienia serwera',
    description:
      'Konfiguracja działania serwera i API. Zmienne PUBLIC_ są wczytywane podczas budowania frontendu — po ich zmianie przebuduj aplikację.',
    options: [
      { key: 'PORT', info: 'Port, na którym nasłuchuje serwer', example: '3000' },
      {
        key: 'DISABLE_GUI',
        info: 'Udostępnia wyłącznie API bez interfejsu graficznego',
        example: 'true',
      },
      {
        key: 'PUBLIC_API_ENDPOINT',
        info: 'Adres endpointu API używany przez frontend',
        example: '/api',
      },
      {
        key: 'PUBLIC_API_TIMEOUT_LIMIT',
        info: 'Limit czasu oczekiwania na pojedynczy test (w milisekundach)',
        example: '25000',
      },
      { key: 'API_ENABLE_RATE_LIMIT', info: 'Włącza ograniczanie liczby zapytań (rate-limiting) do API', example: 'true' },
      {
        key: 'API_CORS_ORIGIN',
        info: 'Dozwolone źródło CORS dla zapytań do API (domyślnie wszystkie)',
        example: 'https://example.com',
      },
      {
        key: 'API_ENABLED_CHECKS',
        info: 'Lista jedynych aktywnych testów (jeśli ustawiono)',
        example: 'get-ip,ssl,dns,headers',
      },
      { key: 'API_DISABLED_CHECKS', info: 'Lista wyłączonych testów', example: 'trace-route,ports' },
      {
        key: 'API_BLOCKED_HOSTS',
        info: 'Hosty, adresy IP lub zakresy CIDR zablokowane przed skanowaniem',
        example: 'lan.example.com,192.168.0.0/16',
      },
      { key: 'PORTS_TO_CHECK', info: 'Lista portów skanowanych przez moduł otwartych portów', example: '22,80,443' },
      {
        key: 'CHROME_PATH',
        info: 'Ścieżka do przeglądarki Chromium (do zrzutów ekranu, stosu technologicznego i trackerów)',
        example: '/usr/bin/chromium',
      },
      {
        key: 'TRUST_PROXY',
        info: 'Konfiguracja za reverse proxy (liczba przeskoków, true lub lista CIDR)',
        example: '1',
      },
      { key: 'LOG_LEVEL', info: 'Poziom logowania: debug, info, warn, error lub silent', example: 'warn' },
    ],
  },
];
---

<PageLayout
  title="Własny hosting (Self-Hosting) | SCAN_KMucha"
  description="Dowiedz się, jak uruchomić SCAN_KMucha lokalnie lub na własnym serwerze."
>
  <h1>Własny hosting (Self-Hosting)</h1>
  <p>Uruchom własną instancję SCAN_KMucha lokalnie lub na swoim serwerze.</p>

  <OptionCards cards={cardData} numbered />

  <section class="config">
    <h2>Konfiguracja</h2>
    <p>
      SCAN_KMucha działa bez dodatkowej konfiguracji — wszystkie poniższe zmienne są opcjonalne.
      <br />
      Możesz je ustawić jako zmienne środowiskowe w pliku <code>.env</code>, w panelu hostingu lub
      przez <code>docker run -e</code>.
    </p>
    {configGroups.map((group) => (
      <details>
        <summary>
          <h3>{group.title}</h3>
          <span>{group.description}</span>
        </summary>
        <dl>
          {group.options.map((option) => (
            <div>
              <dt>{option.key}</dt>
              <dd>
                {option.info}
                {option.example && (
                  <>
                    {' '}
                    (np. <code>{option.example}</code>)
                  </>
                )}
                {option.link && (
                  <a href={option.link} target="_blank" rel="noreferrer">
                    Uzyskaj klucz
                  </a>
                )}
              </dd>
            </div>
          ))}
        </dl>
      </details>
    ))}
  </section>

  <SponsorCard />
</PageLayout>

<style lang="scss">
  @use '@styles/global.scss' as *;
  .config {
    margin-top: 4rem;
    > p {
      max-width: 80ch;
      margin-bottom: 2rem;
      line-height: 1.6;
      color: var(--text-color-secondary);
    }
    details {
      interpolate-size: allow-keywords;
      border-top: 1px solid var(--primary-transparent);
      &:last-of-type {
        border-bottom: 1px solid var(--primary-transparent);
      }
      &::details-content {
        block-size: 0;
        overflow: hidden;
        transition:
          block-size 0.3s ease,
          content-visibility 0.3s allow-discrete;
      }
      &[open]::details-content {
        block-size: auto;
      }
      &[open] summary::after {
        rotate: 225deg;
      }
      @media (prefers-reduced-motion: reduce) {
        &::details-content {
          transition: none;
        }
      }
    }
    summary {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 0.25rem 1rem;
      padding: 1.25rem 0;
      cursor: pointer;
      list-style: none;
      &::-webkit-details-marker {
        display: none;
      }
      &::after {
        content: '';
        grid-area: 1 / 2 / 3;
        align-self: center;
        margin-right: 0.25rem;
        width: 0.5rem;
        height: 0.5rem;
        border: solid var(--primary);
        border-width: 0 2px 2px 0;
        rotate: 45deg;
        transition: rotate 0.3s ease;
      }
      &:hover h3 {
        color: var(--primary-increased-contrast);
      }
      h3 {
        margin: 0;
        font-size: 1.2rem;
        transition: color 0.25s ease;
      }
      span {
        line-height: 1.5;
        color: var(--text-color-secondary);
      }
    }
    code {
      padding: 0.1rem 0.35rem;
      border-radius: 3px;
      background: var(--primary-transparent);
      color: var(--text-color);
      font-family: var(--font-mono);
      font-size: 0.85em;
    }
    dl > div {
      display: grid;
      grid-template-columns: 16rem 1fr;
      align-items: baseline;
      gap: 0.25rem 2rem;
      padding: 0.75rem 0;
      border-top: 1px solid var(--primary-transparent);
      @include mobile-down {
        grid-template-columns: 1fr;
      }
    }
    dt {
      font-family: var(--font-mono);
      font-size: 0.9rem;
      color: var(--primary-increased-contrast);
      overflow-wrap: anywhere;
    }
    dd {
      line-height: 1.5;
      color: var(--text-color-secondary);
      code,
      a {
        margin-left: 0.5rem;
        white-space: nowrap;
      }
    }
  }
</style>
