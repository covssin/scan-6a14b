---
import PageLayout from '@layouts/Page.astro';
import CheckList from '@components/category/CheckList.astro';
import CategoryLinks from '@components/category/CategoryLinks.astro';
import ScanForm from '@components/form/ScanForm.astro';
import { checkIds } from '@/data/checks';
import { categoryIds } from '@/data/categories';
import { checksIntro } from '@/data/about';

const description =
  `Opis wszystkich ${checkIds.length} testów w SCAN_KMucha: co sprawdza każdy moduł, ` +
  'dlaczego ma to znaczenie i jakie standardy techniczne za nim stoją.';
---

<PageLayout
  title="Wszystkie testy — opisy | SCAN_KMucha"
  description={description}
  keywords="testy bezpieczeństwa stron, osint, analiza dns, certyfikat ssl, nagłówki http, audyt seo"
  breadcrumbs={[
    { name: 'SCAN_KMucha', item: '' },
    { name: 'Testy', item: 'checks' },
  ]}
>
  <section class="intro">
    <h1>Opis wszystkich testów</h1>
    <p class="tagline">
      SCAN_KMucha wykonuje {checkIds.length} testów podzielonych na {categoryIds.length} kategorii. Poniżej znajdziesz
      szczegółowy opis każdego z nich: co analizuje, dlaczego jest istotny oraz na jakich standardach bazuje.
    </p>
    <p class="caveat">{checksIntro}</p>
    <ScanForm label="Wpisz adres URL, aby wygenerować pełny raport" />
  </section>

  <CheckList ids={checkIds} heading="Wszystkie testy" showCategories />

  <CategoryLinks heading="Przeglądaj według kategorii" />
</PageLayout>

<style lang="scss">
  .intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;

    h1 {
      margin: 0;
      font-size: clamp(2.25rem, 6vw, 3.5rem);
      line-height: 1.1;
      letter-spacing: -0.02em;
      text-wrap: balance;
    }

    .tagline {
      margin: 0;
      max-width: 62ch;
      font-size: 1.2rem;
      line-height: 1.6;
      color: var(--text-color-secondary);
    }

    .caveat {
      margin: 0;
      font-size: 0.9rem;
      color: var(--text-color-tertiary);
    }
  }
</style>
