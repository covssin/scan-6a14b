---
import PageLayout from '@layouts/Page.astro';
import OptionCards from '@components/molecules/OptionCards.astro';

const cards = [
  {
    title: 'Dokumentacja API',
    description: 'Przeglądaj listę wszystkich dostępnych endpointów, ich parametry, odpowiedzi i przykłady użycia.',
    buttons: [
      { name: 'Specyfikacja OpenAPI', image: '/assets/images/swagger.svg', link: '/web-check-api/spec' },
    ],
  },
  {
    title: 'Klucz API',
    description: 'Zarządzaj dostępem do API i rozpocznij integrację.',
    buttons: [{ name: 'Konto', image: '/assets/images/webauthn.svg', link: '/account' }],
  },
  {
    title: 'Strona główna',
    description: 'Więcej informacji oraz pozostałe projekty znajdziesz na kmucha.pl.',
    buttons: [
      {
        name: 'kmucha.pl',
        image: '/assets/images/swagger.svg',
        link: 'https://kmucha.pl',
        newTab: true,
      },
    ],
  },
];
---

<PageLayout title="API | SCAN_KMucha" description="Rozpocznij pracę z interfejsem API SCAN_KMucha.">
  <h1>SCAN_KMucha API</h1>
  <p class="intro">
    Interfejs SCAN_KMucha API zapewnia programistyczny dostęp do ponad 30 kategorii metryk internetowych.
    <br />
    Zintegruj narzędzie z własnymi skryptami i aplikacjami, aby monitorować wydajność, SEO oraz
    bezpieczeństwo dowolnej witryny.
  </p>

  <OptionCards cards={cards} />
</PageLayout>

<style lang="scss">
  .intro {
    font-size: 1.2rem;
    line-height: 1.5;
    margin-top: 1rem;
  }
</style>
