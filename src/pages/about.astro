---
import PageLayout from '@layouts/Page.astro';
import { about, supportUs, fairUse, privacy, license } from '@/data/about';
import { checkIds } from '@/data/checks';

const siteName = 'kmucha.pl';
const siteLink = 'https://kmucha.pl';
const currentYear = new Date().getFullYear();

const elsewhere = [
  { title: `Wszystkie testy (${checkIds.length}) — opisy`, link: '/checks' },
  { title: 'Własna instancja (Self-hosting)', link: '/self-hosted-setup' },
  { title: 'Dokumentacja API', link: '/web-check-api' },
];
---

<PageLayout
  title="O projekcie | SCAN_KMucha"
  description="Czym jest SCAN_KMucha, jak działa oraz jakie są zasady korzystania z narzędzia."
  keywords="SCAN_KMucha, o projekcie, OSINT, bezpieczeństwo stron, audyt, prywatność"
  breadcrumbs={[
    { name: 'SCAN_KMucha', item: '' },
    { name: 'O projekcie', item: 'about' },
  ]}
>
  <section class="intro">
    <h1>O projekcie SCAN_KMucha</h1>
    {about.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
    <p>
      Projekt rozwijany w ramach <a href={siteLink}>{siteName}</a>.
    </p>
    <ul class="elsewhere">
      {elsewhere.map((link) => (
        <li>
          <a href={link.link}>{link.title}</a>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>Wsparcie i rozwój</h2>
    {supportUs.map((paragraph) => (
      <p set:html={paragraph} />
    ))}
  </section>

  <section>
    <h2>Zasady uczciwego użytkowania</h2>
    <ul>
      {fairUse.map((rule) => (
        <li>{rule}</li>
      ))}
    </ul>
  </section>

  <section>
    <h2>Prywatność</h2>
    {privacy.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
  </section>

  <section>
    <h2>Licencja</h2>
    <p>
      SCAN_KMucha jest udostępniany na licencji MIT, ©{' '}
      <a href={siteLink}>{siteName}</a> {currentYear}. Oprogramowanie oparte na otwartym kodzie
      źródłowym Web-Check.
    </p>
    <pre>{license}</pre>
  </section>
</PageLayout>

<style lang="scss">
  section {
    margin-bottom: 4rem;

    h1 {
      margin: 0 0 1.5rem;
      font-size: clamp(2.25rem, 6vw, 3.5rem);
      line-height: 1.1;
      letter-spacing: -0.02em;
    }

    h2 {
      font-size: 1.6rem;
      margin-bottom: 1rem;
    }

    p,
    li {
      max-width: 68ch;
      line-height: 1.7;
      color: var(--text-color-secondary);
    }

    ul {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
  }

  .elsewhere {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin-top: 1.5rem;

    a {
      display: block;
      padding: 0.5rem 1rem;
      border: 1px solid var(--border);
      border-radius: 3px;
      color: var(--text-color);
      font-weight: 600;
      transition:
        border-color 0.25s ease,
        color 0.25s ease;

      &:hover,
      &:focus-visible {
        border-color: var(--primary);
        color: var(--primary-increased-contrast);
        text-decoration: none;
      }
    }
  }

  pre {
    margin-top: 1.5rem;
    padding: 1rem;
    background: var(--background-raised);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--text-color-tertiary);
    overflow-x: auto;
    max-width: fit-content;
  }
</style>
